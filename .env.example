# ---------------------------------------------------------------------------
# Global Explorer environment template
# Copy to `.env` (git-ignored) and fill in real values.
#
# WARNING: every variable prefixed with VITE_ is statically inlined into the
# client bundle at build time and is therefore PUBLIC. Never put a secret here.
# ---------------------------------------------------------------------------

# Optional. Live REST Countries API key.
# SECURITY: this value ends up in the shipped JavaScript, so treat it as public.
# The app works fully without it by using the bundled offline dataset.
# W11 is moving data fetching to build time so no key is shipped client-side.
VITE_REST_COUNTRIES_KEY=

# Required for production builds. Absolute origin with NO trailing slash.
# Used by W2 to generate absolute sitemap/robots/canonical/OG URLs.
# Example: https://global-explorer.example.com
SITE_URL=https://example.com

# Optional. Some scripts accept SITE as an alias for SITE_URL.
SITE=

# Deploy checklist
# 1. cp .env.example .env
# 2. Set SITE_URL to the real production origin (no trailing slash).
# 3. npm ci                       (installs exactly what package-lock pins)
# 4. npm run check && npm test    (quality gates)
# 5. npm run build                (typecheck + vite build)
# 6. Deploy dist/ using the host config in docs/DEPLOY.md (W1).
