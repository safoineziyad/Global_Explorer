{
  "name": "global-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "check": "node scripts/check-i18n.mjs && node scripts/check-css.mjs",
    "data:atlas": "node scripts/build-atlas.mjs",
    "data:countries": "node scripts/sync-countries.mjs",
    "sitemap": "node scripts/build-sitemap.mjs --",
    "test": "node --test",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
