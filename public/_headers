# Cloudflare Pages response headers (also honoured by Netlify).
# Full per-host guide: docs/DEPLOY.md

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://flagcdn.com; font-src 'self'; connect-src 'self' https://restcountries.com; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()

# Vite emits content-hashed files under /assets, so they are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell must revalidate so a new deploy is picked up immediately.
/index.html
  Cache-Control: no-cache

# The service worker and web manifest must never be cached, otherwise clients
# stay pinned to a dead worker and stale install metadata.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/site.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
